code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_disabled, unshaded;

uniform vec4 PlayerColor = vec4(1.000000, 0.000000, 1.000000, 0.000000);
uniform float AbilityProgress : hint_range(0.0, 1.0) = 0.0;



void fragment() {
// Vector4Parameter:4
	vec4 n_out4p0 = PlayerColor;


// FloatParameter:10
	float n_out10p0 = AbilityProgress;


// FloatFunc:17
	float n_out17p0 = -(n_out10p0);


// FloatOp:18
	float n_in18p1 = 1.00000;
	float n_out18p0 = n_out17p0 + n_in18p1;


// Input:5
	vec2 n_out5p0 = UV;
	float n_out5p2 = n_out5p0.g;


// FloatOp:15
	float n_in15p1 = 1.00000;
	float n_out15p0 = n_out5p2 * n_in15p1;


// Step:6
	float n_out6p0 = step(n_out18p0, n_out15p0);


// Clamp:20
	float n_in20p1 = 0.30000;
	float n_in20p2 = 1.00000;
	float n_out20p0 = clamp(n_out6p0, n_in20p1, n_in20p2);


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out20p0;


}
